# Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Shopify Storefront API
NEXT_PUBLIC_SHOPIFY_DOMAIN=your-shopify-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-shopify-access-token

# Radio streaming URL (RadioKing stream)
NEXT_PUBLIC_RADIO_STREAM_URL=https://stream.radioking.com/your-stream-id

# Backend API
BACKEND_PORT=8080
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/hotmess

# GDPR Compliance
PRIVACY_EMAIL=privacy@hotmess.london

# Misc configuration
